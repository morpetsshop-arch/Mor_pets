<% if (p.hasAromas === false) { %>
  <div class="carousel single">
    <figure class="slide">
      <% if (p.image) { %><img src="<%= p.image %>" alt="<%= p.name %>" loading="lazy">
      <% } else { %><span class="pic"><%= p.emoji %></span><% } %>
    </figure>
  </div>
<% } else { %>
<div class="carousel" data-carousel data-start="<%= locals.current ?? '' %>" <% if (locals.auto) { %>data-auto<% } %>>
  <div class="track">
    <% aromas.forEach(a => { %>
      <figure class="slide" data-aroma="<%= a.id %>">
        <% if (a.src) { %><img src="<%= a.src %>" alt="<%= p.name %> aroma <%= a.name %>" loading="lazy">
        <% } else { %><span class="pic"><%= p.emoji %></span><% } %>
        <figcaption><%= a.name %></figcaption>
      </figure>
    <% }) %>
  </div>
  <button type="button" class="nav prev" aria-label="Aroma anterior">‹</button>
  <button type="button" class="nav next" aria-label="Aroma siguiente">›</button>
</div>
<% } %>